API_KEY=change-me-to-a-long-random-string

API_KEY=change-me-to-a-long-random-string

# OpenRouter (default): meta-llama/llama-3.3-70b-instruct:free
# Groq: set LLM_BASE_URL=https://api.groq.com/openai/v1 and LLM_MODEL=llama-3.3-70b-versatile
# Gemini: set LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai and LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

DATABASE_URL=sqlite+aiosqlite:///./data/jobmanager.db
DATA_DIR=./data
BROWSER_HEADLESS=true

WEB_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:1420