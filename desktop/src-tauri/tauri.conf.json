{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobBot Widget",
  "version": "1.0.0",
  "identifier": "dev.jobmanager.widget",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "JobBot",
        "width": 380,
        "height": 560,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../web/public/icons/icon.svg"]
  }
}